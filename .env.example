# OneMap MCP Server Environment Configuration
# Copy this file to .env and fill in your credentials

# OneMap Authentication (Required if ONEMAP_TOKEN not provided)
# Get your credentials at https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=your_email@example.com
ONEMAP_EMAIL_PASSWORD=your_password

# OneMap API Token (Optional - if provided, will use this instead of email/password)
# You can get a token from the OneMap API authentication endpoint
# ONEMAP_TOKEN=your_jwt_token_here

# OneMap API Token (Optional - if provided, will use this instead of email/password)
# You can get a token from the OneMap API or use email/password above
ONEMAP_TOKEN=
# URA Space API (Required for land sales, master plan data)
# Get your access key at https://www.ura.gov.sg/maps/api/
URA_ACCESS_KEY=